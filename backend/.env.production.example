# Copy to backend/.env on the production server and fill every blank value.
APP_ENV=production
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=
AUTH_SECRET_KEY=

# Keep SQL Server private. For a same-machine SQL Server, SQL_SERVER can be localhost.
SQL_SERVER=
SQL_DATABASE=
SQL_DRIVER=ODBC Driver 17 for SQL Server

# Use yes only when the Windows service account running FastAPI has SQL access.
# Otherwise use no and provide a dedicated, least-privilege SQL login below.
SQL_TRUSTED_CONNECTION=no
SQL_USER=
SQL_PASSWORD=
